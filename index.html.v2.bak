      </div>
      <div class="time-calc spotlight-card">
        <div class="calc-header">
          <span class="tag-mono">КЛІПІВ НА ТИЖДЕНЬ: <span id="clipsVal" class="text-lime">10</span></span>
        </div>
        <input type="range" id="clipsSlider" min="1" max="50" value="10" class="calc-slider">
        <div class="calc-result">
          <div class="calc-col">
            <div class="tag-mono calc-label">РУЧНИЙ ТРЕКІНГ</div>
            <div class="calc-time" id="manualTime">250 хв</div>
            <div class="calc-sub" id="manualHours">≈ 4.2 год / тиж</div>
          </div>
          <div class="calc-vs tag-mono" style="font-size: 2rem; color: var(--border-subtle);">VS</div>
          <div class="calc-col calc-col-auto">
            <div class="tag-mono calc-label text-cyan">AUTOTRACKER</div>
            <div class="calc-time text-lime" id="autoTime">5 хв</div>
            <div class="calc-sub" id="autoSave">98% економія</div>
          </div>
        </div>
      </div>
    </div>
  </section>

