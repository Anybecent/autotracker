    const rootHtml = document.documentElement;
    const siteToast = document.getElementById('siteToast');
    let toastTimer = null;
    let currentLang = 'uk';

    function showToast(html) {
      if(!siteToast) return;
      siteToast.innerHTML = html;
      siteToast.classList.add('visible');
      if(toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => siteToast.classList.remove('visible'), 5000);
    }

    // 1. Language Toggle
    function setLanguage(lang) {
      currentLang = lang;
      rootHtml.setAttribute('lang', lang);
      document.getElementById('langLabel').textContent = lang === 'uk' ? 'UA' : 'EN';
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if(I18N[lang] && I18N[lang][key]) {
          el.innerHTML = I18N[lang][key];
        }
      });
      localStorage.setItem('autotracker_lang', lang);
    }
    const savedLang = localStorage.getItem('autotracker_lang') || 'uk';
    setLanguage(savedLang);

    document.getElementById('langToggle').addEventListener('click', () => {
      setLanguage(currentLang === 'uk' ? 'en' : 'uk');
    });

    // 2. Theme Toggle
    function applyTheme(theme) {
      rootHtml.setAttribute('data-theme', theme);
      document.getElementById('themeIcon').textContent = theme === 'dark' ? '🌙' : '☀️';
      localStorage.setItem('autotracker_theme', theme);
    }
    const savedTheme = localStorage.getItem('autotracker_theme') || 'dark';
    applyTheme(savedTheme);

    document.getElementById('themeToggle').addEventListener('click', () => {
      const isDark = rootHtml.getAttribute('data-theme') === 'dark';
      applyTheme(isDark ? 'light' : 'dark');
    });

    // 3. Navbar scroll
    window.addEventListener('scroll', () => {
      const nav = document.getElementById('navbar');
      if(window.scrollY > 20) nav.classList.add('scrolled');
      else nav.classList.remove('scrolled');
    });

    // 4. Buy Links
    document.querySelectorAll(".buy-link").forEach((link) => {
      link.setAttribute("href", CHECKOUT_URL);
      link.setAttribute("target", "_blank");
      link.setAttribute("rel", "noopener noreferrer");
    });

    // 5. Video Slots
    document.querySelectorAll(".video-element").forEach((video) => {
      const frame = video.closest(".video-frame") || video.closest(".custom-player");
      const placeholder = frame ? frame.querySelector(".video-placeholder") : null;
      if (!frame || !placeholder) return;

      function markLoaded() {
        if (video.readyState >= 1 && video.videoWidth > 0) frame.classList.add("has-video");
      }
      video.addEventListener("loadedmetadata", markLoaded);
      video.addEventListener("canplay", markLoaded);
      video.addEventListener("error", () => frame.classList.remove("has-video"));

      placeholder.addEventListener("click", () => {
        const input = document.createElement("input");
        input.type = "file"; input.accept = "video/mp4";
        input.onchange = () => {
          if (input.files[0]) {
            video.src = URL.createObjectURL(input.files[0]);
            frame.classList.add("has-video");
            video.play().catch(()=>{});
          }
        };
        input.click();
      });
    });

    // 6. FAQ Accordion
    document.querySelectorAll(".faq-question").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.parentElement;
        const isOpen = item.classList.contains("open");
        document.querySelectorAll(".faq-item").forEach(other => other.classList.remove("open"));
        if (!isOpen) item.classList.add("open");
      });
    });

    // JS MODULE 1: SpotlightCards
    document.querySelectorAll('.spotlight-card').forEach(card => {
      card.addEventListener('mousemove', e => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
      card.addEventListener('mouseleave', () => {
        card.style.setProperty('--mouse-x', '-999px');
        card.style.setProperty('--mouse-y', '-999px');
      });
    });

    // JS MODULE 2: Tilt3D
    function attachTilt(el, max = 6) {
      el.addEventListener('mousemove', e => {
        const r = el.getBoundingClientRect();
        const rx = ((e.clientY - r.top) / r.height - 0.5) * -max * 2;
        const ry = ((e.clientX - r.left) / r.width - 0.5) * max * 2;
        el.style.transform = `perspective(1000px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale3d(1.02,1.02,1.02)`;
        el.style.transition = 'transform 0.1s ease-out';
      });
      el.addEventListener('mouseleave', () => {
        el.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale3d(1,1,1)';
        el.style.transition = 'transform 0.4s cubic-bezier(0.16,1,0.3,1)';
      });
    }
    document.querySelectorAll('.tilt-card').forEach(c => attachTilt(c));

    // JS MODULE 3: TimelineScrubber
    (function() {
      const ruler = document.getElementById('tlRuler');
      const playhead = document.getElementById('tlPlayhead');
      const dot = document.getElementById('tlDot');
      const timecode = document.getElementById('tlTimecode');
      const diamonds = document.querySelectorAll('.kf-diamond');
      if (!ruler || !playhead) return;
      
      let dragging = false;
      let progress = 0.35;
      
      function setProgress(p) {
        progress = Math.max(0, Math.min(1, p));
        playhead.style.left = (progress * 100) + '%';
        if (dot) dot.style.left = (12 + progress * 76) + '%';
        const totalSec = Math.round(progress * 10);
        const frames = Math.round(progress * 240) % 24;
        if (timecode) timecode.textContent = `[00:00:0${totalSec}:${String(frames).padStart(2,'0')}]`;
        const positions = [0.12, 0.38, 0.63, 0.88];
        diamonds.forEach((d, i) => {
          const dist = Math.abs(progress - positions[i]);
          d.classList.toggle('active', dist < 0.07);
        });
      }
      
      ruler.addEventListener('mousedown', e => {
        dragging = true;
        const r = ruler.getBoundingClientRect();
        setProgress((e.clientX - r.left) / r.width);
      });
      document.addEventListener('mousemove', e => {
        if (!dragging) return;
        const r = ruler.getBoundingClientRect();
        setProgress((e.clientX - r.left) / r.width);
      });
      document.addEventListener('mouseup', () => { dragging = false; });
      setProgress(0.35);
    })();

    // JS MODULE 4: TimeSaverCalculator
    (function() {
      const slider = document.getElementById('clipsSlider');
      const clipsVal = document.getElementById('clipsVal');
      const manualTime = document.getElementById('manualTime');
      const manualHours = document.getElementById('manualHours');
      const autoTime = document.getElementById('autoTime');
      const autoSave = document.getElementById('autoSave');
      if (!slider) return;
      
      function update() {
        const clips = parseInt(slider.value);
        const manual = clips * 25;
        const auto = Math.round(clips * 0.5);
        const save = Math.round((1 - auto / manual) * 100);
        if (clipsVal) clipsVal.textContent = clips;
        if (manualTime) manualTime.textContent = manual + ' хв';
        if (manualHours) manualHours.textContent = '≈ ' + (manual/60).toFixed(1) + ' год / тиж';
        if (autoTime) autoTime.textContent = auto + ' хв';
        if (autoSave) autoSave.textContent = save + '% економія';
      }
      slider.addEventListener('input', update);
      update();
    })();

    // JS MODULE 5: Custom Video Player
    (function() {
      const video = document.getElementById('mainVideo');
      const playBtn = document.getElementById('playerPlayBtn');
      const fill = document.getElementById('playerFill');
      const progress = document.getElementById('playerProgress');
      const timeEl = document.getElementById('playerTime');
      const overlay = document.getElementById('playerOverlay');
      if (!video || !playBtn) return;
      
      function formatTime(s) {
        const m = Math.floor(s / 60);
        return m + ':' + String(Math.floor(s % 60)).padStart(2, '0');
      }
      
      playBtn.addEventListener('click', () => {
        if (video.paused) { video.play(); playBtn.textContent = '⏸'; }
        else { video.pause(); playBtn.textContent = '▶'; }
      });
      
      video.addEventListener('timeupdate', () => {
        if (!video.duration) return;
        const p = video.currentTime / video.duration * 100;
        if (fill) fill.style.width = p + '%';
        if (timeEl) timeEl.textContent = formatTime(video.currentTime);
      });
      
      if (progress) {
        progress.addEventListener('click', e => {
          const r = progress.getBoundingClientRect();
          video.currentTime = ((e.clientX - r.left) / r.width) * video.duration;
        });
      }
      
      document.querySelectorAll('.spd').forEach(btn => {
        btn.addEventListener('click', () => {
          video.playbackRate = parseFloat(btn.dataset.speed);
          document.querySelectorAll('.spd').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
      
      const wrapper = document.getElementById('mainPlayerWrap');
      if (wrapper) {
        wrapper.addEventListener('mouseenter', () => { if(overlay) overlay.style.opacity = '1'; });
        wrapper.addEventListener('mouseleave', () => { if(overlay && video.paused) overlay.style.opacity = '1'; else if(overlay) overlay.style.opacity = '0'; });
      }
    })();

    // JS MODULE 6: Canvas Tracker
    class SpringPoint {
      constructor(x, y) {
        this.x = x; this.y = y;
        this.targetX = x; this.targetY = y;
        this.vx = 0; this.vy = 0;
        this.stiffness = 0.08; this.damping = 0.82;
      }
      update() {
        const ax = (this.targetX - this.x) * this.stiffness;
        const ay = (this.targetY - this.y) * this.stiffness;
        this.vx = (this.vx + ax) * this.damping;
        this.vy = (this.vy + ay) * this.damping;
        this.x += this.vx; this.y += this.vy;
      }
    }

    class CanvasTracker {
      constructor(canvasEl) {
        this.canvas = canvasEl;
        this.ctx = canvasEl.getContext('2d');
        this.mode = 'attach';
        this.t = 0;
        this.locked = false;
        this.trail = [];
        this.mouse = { x: 0, y: 0 };
        this.featurePoints = [];
        this.animId = null;
        this.active = false;
        this.init();
      }
      
      init() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = this.canvas.parentElement.getBoundingClientRect();
        this.canvas.width = rect.width * dpr;
        this.canvas.height = rect.height * dpr;
        this.ctx.scale(dpr, dpr);
        this.W = rect.width;
        this.H = rect.height;
        
        this.reticle = new SpringPoint(this.W / 2, this.H / 2);
        this.target = { x: this.W / 2, y: this.H / 2 };
        
        this.featurePoints = Array.from({ length: 35 }, () => ({
          ox: (Math.random() - 0.5) * 70, oy: (Math.random() - 0.5) * 50, jx: 0, jy: 0
        }));
        
        this.canvas.addEventListener('mousemove', (e) => {
          const r = this.canvas.getBoundingClientRect();
          this.mouse.x = e.clientX - r.left;
          this.mouse.y = e.clientY - r.top;
          this.reticle.targetX = this.mouse.x;
          this.reticle.targetY = this.mouse.y;
        });
        
        this.canvas.addEventListener('click', () => {
          this.locked = !this.locked;
          document.getElementById('hudStatus').textContent = this.locked ? 'LOCKED ◆' : 'SCANNING';
        });
      }
      
      update() {
        this.t += 0.016;
        this.target.x = this.W / 2 + Math.sin(this.t * 0.7) * (this.W * 0.28);
        this.target.y = this.H / 2 + Math.sin(this.t * 0.45 + 1) * (this.H * 0.22);
        
        this.reticle.update();
        
        this.trail.push({ x: this.target.x, y: this.target.y });
        if (this.trail.length > 30) this.trail.shift();
        
        this.featurePoints.forEach(p => {
          p.jx += (Math.random() - 0.5) * 1.2; p.jy += (Math.random() - 0.5) * 1.2;
          p.jx *= 0.88; p.jy *= 0.88;
        });
        
        const hud = document.getElementById('hudCoords');
        if (hud) hud.textContent = `X: ${this.target.x.toFixed(1).padStart(5, '0')} Y: ${this.target.y.toFixed(1).padStart(5, '0')}`;
      }
      
      drawGrid(ctx, W, H) {
        ctx.strokeStyle = 'rgba(255,255,255,0.04)';
        ctx.lineWidth = 0.5;
        const step = 40;
        for (let x = 0; x < W; x += step) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
        for (let y = 0; y < H; y += step) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
      }
      
      drawTrackingBox(ctx, x, y, w, h, color) {
        const L = 14;
        ctx.strokeStyle = color; ctx.lineWidth = 1.5; ctx.beginPath();
        ctx.moveTo(x, y + L); ctx.lineTo(x, y); ctx.lineTo(x + L, y);
        ctx.moveTo(x + w - L, y); ctx.lineTo(x + w, y); ctx.lineTo(x + w, y + L);
        ctx.moveTo(x + w, y + h - L); ctx.lineTo(x + w, y + h); ctx.lineTo(x + w - L, y + h);
        ctx.moveTo(x + L, y + h); ctx.lineTo(x, y + h); ctx.lineTo(x, y + h - L);
        ctx.stroke();
        ctx.strokeStyle = color + '88'; ctx.lineWidth = 0.8; ctx.beginPath();
        ctx.moveTo(x + w/2 - 6, y + h/2); ctx.lineTo(x + w/2 + 6, y + h/2);
        ctx.moveTo(x + w/2, y + h/2 - 6); ctx.lineTo(x + w/2, y + h/2 + 6);
        ctx.stroke();
      }
      
      drawTrail(ctx) {
        if (this.trail.length < 2) return;
        ctx.strokeStyle = 'rgba(212,255,0,0.35)'; ctx.lineWidth = 1.5; ctx.setLineDash([3, 3]); ctx.beginPath();
        ctx.moveTo(this.trail[0].x, this.trail[0].y);
        for (let i = 1; i < this.trail.length; i++) ctx.lineTo(this.trail[i].x, this.trail[i].y);
        ctx.stroke(); ctx.setLineDash([]);
      }
      
      drawFeaturePoints(ctx, cx, cy) {
        ctx.fillStyle = 'rgba(0,240,255,0.7)';
        this.featurePoints.forEach(p => {
          ctx.beginPath(); ctx.arc(cx + p.ox + p.jx, cy + p.oy + p.jy, 1.5, 0, Math.PI * 2); ctx.fill();
        });
      }
      
      drawReticle(ctx, x, y) {
        const R1 = 18, R2 = 28;
        ctx.strokeStyle = '#d4ff00'; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(x, y, R2, 0.2, Math.PI * 2 - 0.2); ctx.stroke();
        ctx.strokeStyle = 'rgba(212,255,0,0.5)'; ctx.beginPath(); ctx.arc(x, y, R1, 0, Math.PI * 2); ctx.stroke();
        ctx.strokeStyle = '#d4ff00'; ctx.lineWidth = 1; const arms = 10; ctx.beginPath();
        ctx.moveTo(x - R2 - arms, y); ctx.lineTo(x - R1, y); ctx.moveTo(x + R1, y); ctx.lineTo(x + R2 + arms, y);
        ctx.moveTo(x, y - R2 - arms); ctx.lineTo(x, y - R1); ctx.moveTo(x, y + R1); ctx.lineTo(x, y + R2 + arms); ctx.stroke();
      }
      
      drawAttachedBadge(ctx, tx, ty, vx) {
        const bw = 90, bh = 26; const bx = tx + 30 + Math.abs(vx) * 2; const by = ty - 50; const angle = vx * 0.04;
        ctx.save(); ctx.translate(bx + bw/2, by + bh/2); ctx.rotate(angle); ctx.translate(-(bx + bw/2), -(by + bh/2));
        ctx.fillStyle = 'rgba(212,255,0,0.15)'; ctx.strokeStyle = '#d4ff00'; ctx.lineWidth = 1; ctx.beginPath();
        if(ctx.roundRect) ctx.roundRect(bx, by, bw, bh, 4); else ctx.rect(bx, by, bw, bh); // fallback
        ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#d4ff00'; ctx.font = '500 10px "JetBrains Mono", monospace'; ctx.textAlign = 'center';
        ctx.fillText('@target_label', bx + bw/2, by + 16);
        ctx.strokeStyle = 'rgba(212,255,0,0.5)'; ctx.lineWidth = 0.8; ctx.setLineDash([3,3]); ctx.beginPath();
        ctx.moveTo(tx + 10, ty - 10); ctx.lineTo(bx, by + bh/2); ctx.stroke(); ctx.setLineDash([]); ctx.restore();
      }
      
      draw() {
        const { ctx, W, H } = this;
        ctx.clearRect(0, 0, W, H);
        this.drawGrid(ctx, W, H);
        
        const tx = this.target.x, ty = this.target.y;
        const prevVx = this.trail.length > 1 ? this.trail[this.trail.length-1].x - this.trail[this.trail.length-2].x : 0;
        const bw = 80, bh = 56;
        
        if (this.mode === 'lockon') {
          const cx = W/2, cy = H/2; const offX = cx - tx, offY = cy - ty;
          ctx.save(); ctx.translate(offX, offY); this.drawTrail(ctx); this.drawFeaturePoints(ctx, tx, ty); ctx.restore();
          this.drawTrackingBox(ctx, cx - bw/2, cy - bh/2, bw, bh, '#00f0ff'); this.drawReticle(ctx, cx, cy);
          ctx.fillStyle = '#00f0ff'; ctx.font = '500 9px "JetBrains Mono", monospace'; ctx.textAlign = 'center';
          ctx.fillText('LOCK-ON ◆', cx, cy + bh/2 + 14);
        } else {
          this.drawTrail(ctx); this.drawFeaturePoints(ctx, tx, ty);
          this.drawTrackingBox(ctx, tx - bw/2, ty - bh/2, bw, bh, this.locked ? '#d4ff00' : 'rgba(212,255,0,0.6)');
          if (this.locked) this.drawAttachedBadge(ctx, tx, ty, prevVx);
          this.drawReticle(ctx, this.reticle.x, this.reticle.y);
        }
      }
      
      start() {
        this.active = true;
        const loop = () => { if (!this.active) return; this.update(); this.draw(); this.animId = requestAnimationFrame(loop); };
        loop();
      }
      stop() { this.active = false; if (this.animId) cancelAnimationFrame(this.animId); }
    }

    const c = document.getElementById('trackerCanvas');
    if (c) {
      const tracker = new CanvasTracker(c);
      tracker.start();
      document.querySelectorAll('.mode-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          tracker.mode = tab.getAttribute('data-mode');
        });
      });
      window.addEventListener('resize', () => { tracker.init(); tracker.draw(); });
    }
  </script>
</body>
</html>
